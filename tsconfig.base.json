{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@cleanercms/domain": ["packages/domain/src/index.ts"],
      "@cleanercms/domain/*": ["packages/domain/src/*"],
      "@cleanercms/shared": ["packages/shared/src/index.ts"],
      "@cleanercms/shared/*": ["packages/shared/src/*"]
    }
  }
}
